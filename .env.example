# Copie este arquivo para .env.local (Next.js) e preencha. NUNCA commite o .env real.
# Na Vercel, as mesmas variáveis vão em Settings > Environment Variables.

# ---------- Só no servidor (nunca com prefixo NEXT_PUBLIC_) ----------
# Claude Console > API Keys
ANTHROPIC_API_KEY=
# Supabase > Project Settings > API > service_role (ignora RLS: nunca no front)
SUPABASE_SERVICE_ROLE_KEY=
# @BotFather
TELEGRAM_BOT_TOKEN=
# Console do Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
# openrouteservice.org (gerar chave nova; a antiga foi exposta)
ORS_API_KEY=
# Conta Fogo Cruzado
FOGO_CRUZADO_EMAIL=
FOGO_CRUZADO_PASSWORD=

# ---------- Pode ir ao navegador (só com RLS ligado no Supabase) ----------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
